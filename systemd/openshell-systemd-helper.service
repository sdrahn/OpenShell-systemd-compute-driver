#
# The privileged helper of the systemd compute driver. It serves one user:
# set the gateway's in a drop-in,
#   [Service]
#   Environment=OPENSHELL_SYSTEMD_HELPER_ALLOW_USER=<user>

[Unit]
Description=OpenShell systemd compute driver helper
Documentation=https://github.com/sdrahn/OpenShell-systemd-compute-driver

[Service]
Type=exec
ExecStart=/usr/libexec/openshell/openshell-systemd-helper
# The directory of its socket.
RuntimeDirectory=openshell-systemd-helper
RuntimeDirectoryMode=0755
# Of root's rights, those for files that are another user's; no other
# kind of socket than a local one.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
