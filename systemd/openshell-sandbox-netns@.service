#
# The outer network fence of one sandbox (%i: its ID): a network namespace
# with loopback only, which systemd makes for this unit and keeps while
# the unit is active. The workload's unit joins it. A non-root process may
# bind low ports in it, as in the container drivers' namespaces:
# openshell-sandbox serves the policy DNS on port 53.

[Unit]
Description=OpenShell sandbox %i network namespace
Documentation=https://github.com/sdrahn/OpenShell-systemd-compute-driver
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateNetwork=yes
# A unit that joins this one shares its /tmp as well: private, so that
# the workload's stays writable and its own.
PrivateTmp=yes
# The workload joins this unit's namespaces: shared memory and message
# queues of the sandbox's own, not the host's.
PrivateIPC=yes
ExecStart=sysctl -q -w net.ipv4.ip_unprivileged_port_start=0
# It writes one setting of its own network namespace, as root, and ends.
# Of root's rights it keeps the one for that, and nothing of the host is
# writable for it. With the SELinux module it runs in a domain that may
# do nothing else; "-": a host without the module has no such domain.
SELinuxContext=-system_u:system_r:openshell_sandbox_netns_t:s0
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
