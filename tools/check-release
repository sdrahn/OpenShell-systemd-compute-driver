#!/bin/sh
# SPDX-FileCopyrightText: Copyright (c) 2026 Daniel Rahn
# SPDX-License-Identifier: Apache-2.0
#
# check-release: check that a commit is ready to be tagged vX.Y.Z, or that
# a tag matches what it releases (the Release workflow runs it before
# publishing anything). Run it from the repository, before tagging:
#
#   tools/check-release v0.1.0 [<commit>]
#
# It checks the files as they are in <commit> (default: the tag if it
# exists, else HEAD):
#   - packaging/suse/openshell-driver-systemd.spec has Version: X.Y.Z,
#     and Cargo.toml and Cargo.lock give the crate the same version;
#   - the first "## " heading of CHANGELOG.md is "## vX.Y.Z — <date>",
#     and changes.d holds no fragment that is not in it yet
#     (tools/changelog release);
#   - the tree holds sources only (tools/check-tree).
# Each mismatch is printed with the file to fix; the exit status is 1 if
# there is one. packaging/suse/README.md, "Releases", is the process.
set -eu

tag=${1:?usage: check-release vX.Y.Z [commit]}
case "$tag" in
v[0-9]*.[0-9]*.[0-9]*) ;;
*) echo "check-release: $tag is not a tag vX.Y.Z" >&2; exit 2 ;;
esac
version=${tag#v}
base=${version%%-*} # v1.2.0-rc1: the files name 1.2.0
name=openshell-driver-systemd
if [ $# -ge 2 ]; then
	rev=$2
elif git rev-parse -q --verify "refs/tags/$tag^{commit}" >/dev/null; then
	rev=$tag
else
	rev=HEAD
fi

failed=0
fail() {
	echo "check-release: $1" >&2
	failed=1
}

spec=$(git show "$rev:packaging/suse/$name.spec" | sed -n 's/^Version:[[:space:]]*//p' | head -n 1)
[ "$spec" = "$base" ] ||
	fail "packaging/suse/$name.spec says Version: $spec, not $base"

# The [package] table is the first of Cargo.toml.
crate=$(git show "$rev:Cargo.toml" | sed -n 's/^version = "\(.*\)"$/\1/p' | head -n 1)
[ "$crate" = "$base" ] ||
	fail "Cargo.toml says version = \"$crate\", not \"$base\""

locked=$(git show "$rev:Cargo.lock" | awk -v name="$name" '
	$1 == "name" && $3 == "\"" name "\"" { found = 1; next }
	found && $1 == "version" { gsub(/"/, "", $3); print $3; exit }')
[ "$locked" = "$base" ] ||
	fail "Cargo.lock has $name at $locked, not $base"

heading=$(git show "$rev:CHANGELOG.md" 2>/dev/null | grep -m1 '^## ' || true)
case "$heading" in
"## $tag "*) ;;
*) fail "the first section of CHANGELOG.md is \"$heading\", not \"## $tag — <date>\"" ;;
esac

left=$(git ls-tree -r --name-only "$rev" -- changes.d | grep -v '^changes\.d/README\.md$' || true)
[ -z "$left" ] ||
	fail "changes.d still has $(echo "$left" | tr '\n' ' ')- not in CHANGELOG.md yet (tools/changelog release $tag)"

"$(dirname "$0")/check-tree" "$rev" >&2 || failed=1

if [ "$failed" = 0 ]; then
	echo "check-release: $(git rev-parse --short "$rev") is ready for $tag"
fi
exit "$failed"
