<!--
  OBS source services for openshell-driver-systemd. Run them locally with
    osc service manualrun
  to refresh the package's four source files (OBS builds have no network
  access), then commit them:
    openshell-driver-systemd-<version>.tar.gz   this repository
    openshell-<release>.tar.gz                  OpenShell's source, at the
                                                commit Cargo.lock locks
    vendor.tar.zst                              the driver's crates
    vendor-openshell.tar.zst                    OpenShell's crates
  The crates are vendored as Cargo.lock locks them (no update). Delete
  the files of the previous run first: cargo_vendor takes the first
  tarball that matches. tools/openshell-version keeps OpenShell's
  revision and version below in step with Cargo.lock.
-->
<services>
  <service name="tar_scm" mode="manual">
    <param name="url">https://github.com/sdrahn/OpenShell-systemd-compute-driver.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="versionformat">0.3.0+git%cd.%h</param>
    <param name="filename">openshell-driver-systemd</param>
    <param name="exclude">.git</param>
    <param name="exclude">.github</param>
  </service>
  <service name="tar_scm" mode="manual">
    <param name="url">https://github.com/NVIDIA/OpenShell.git</param>
    <param name="scm">git</param>
    <param name="revision">f3d976590d3eb1379690a2abaf0f0e26c21d487d</param>
    <param name="version">0.1.8</param>
    <param name="filename">openshell</param>
    <param name="exclude">.git</param>
  </service>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version" mode="manual">
    <param name="basename">openshell-driver-systemd</param>
  </service>
  <service name="cargo_vendor" mode="manual">
    <param name="src">openshell-driver-systemd-*.tar.gz</param>
    <param name="update">false</param>
    <param name="respect-lockfile">true</param>
    <param name="compression">zst</param>
  </service>
  <service name="cargo_vendor" mode="manual">
    <param name="src">openshell-0.1.8.tar.gz</param>
    <param name="tag">openshell</param>
    <param name="update">false</param>
    <param name="respect-lockfile">true</param>
    <param name="compression">zst</param>
  </service>
</services>
