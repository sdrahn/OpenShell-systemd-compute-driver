#
# make-sources: the three source files of the package, into a directory:
#
#   openshell-driver-systemd-<version>.tar.gz   this tree, at HEAD
#   openshell-<release>.tar.gz                  OpenShell's source at the
#                                               release of tools/openshell-version
#   vendor.tar.zst                              the driver's crates
#
#   packaging/suse/make-sources <directory>
#
# They are the files OBS's services make from _service (osc service
# manualrun), laid out the same way: the vendor tarball holds Cargo.lock,
# the .cargo/config.toml that makes Cargo use the crates offline and the
# vendor directory, for the top of its tree. CI and the Release workflow
# use this script; a build service project can use either.
#
# Needs git, cargo, curl, zstd and the network. The package build itself
# needs none of the network.
set -euo pipefail
[ $# = 1 ] || { echo "usage: $0 <directory>" >&2; exit 2; }
root=$(cd "$(dirname "$0")/../.." && pwd)
mkdir -p "$1"
out=$(cd "$1" && pwd)
name=openshell-driver-systemd
version=$(awk '$1 == "Version:" {print $2}' "$root/packaging/suse/$name.spec")
release=$("$root/tools/openshell-version")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

git -C "$root" archive --format=tar.gz --prefix="$name-$version/" -o "$out/$name-$version.tar.gz" HEAD
# By the commit Cargo.lock names for the release, not by the tag: a tag
# can be moved, and the driver's own crates are locked to that commit.
commit=$(grep -m1 -o 'NVIDIA/OpenShell?tag=[^#]*#[0-9a-f]*' "$root/Cargo.lock" | sed 's/.*#//')
[ "${#commit}" = 40 ] || { echo "no commit of OpenShell in Cargo.lock" >&2; exit 1; }
grep -q "NVIDIA/OpenShell?tag=$release#$commit" "$root/Cargo.lock" ||
	{ echo "Cargo.lock is not at OpenShell $release" >&2; exit 1; }
echo "OpenShell $release at $commit"
curl -fsSL --retry 3 -o "$work/openshell.tar.gz" "https://github.com/NVIDIA/OpenShell/archive/$commit.tar.gz"
# GitHub names the directory after the commit; the spec expects
# openshell-<release without v>.
mkdir "$work/src"
tar -xzf "$out/$name-$version.tar.gz" -C "$work/src"
tree=$work/src/$name-$version
mkdir "$tree/openshell-${release#v}"
tar -xzf "$work/openshell.tar.gz" -C "$tree/openshell-${release#v}" --strip-components=1
tar -czf "$out/openshell-${release#v}.tar.gz" -C "$tree" "openshell-${release#v}"

# vendor DIR NAME TARBALL: vendor the crates of the workspace in DIR into
# DIR/NAME and pack them as cargo_vendor does: with Cargo.lock and the
# tree's .cargo/config.toml, to which the source replacement is added.
vendor() {
	local dir=$1 name=$2 tarball=$3
	(
		cd "$dir"
		mkdir -p .cargo
		touch .cargo/config.toml
		{
			cat .cargo/config.toml
			echo
			cargo vendor --locked --versioned-dirs "$name"
		} >"$work/config.toml"
		mv "$work/config.toml" .cargo/config.toml
		tar --zstd --sort=name --owner=0 --group=0 --numeric-owner --mtime=@0 \
			-cf "$tarball" Cargo.lock .cargo/config.toml "$name"
	)
}
vendor "$tree" vendor "$out/vendor.tar.zst"
cp "$root/packaging/suse/$name.spec" "$out/"
ls -l "$out"
